{
  // Configuración para renderizar correctamente emojis y símbolos Unicode
  "editor.unicodeHighlight.allowedCharacters": {
    "→": true,
    "✅": true,
    "❌": true,
    "⚠": true,
    "⏳": true,
    "🔵": true,
    "🔴": true,
    "🔄": true
  },
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.unicodeHighlight.nonBasicASCII": false,
  
  // Asegurar que se use una fuente que soporte emojis
  "editor.fontFamily": "Consolas, 'Segoe UI Emoji', 'Courier New', monospace",
  
  // Habilitar ligaduras y renderizado de símbolos
  "editor.fontLigatures": true,
  
  // Configuración de archivos markdown
  "[markdown]": {
    "editor.unicodeHighlight.allowedCharacters": {
      "→": true,
      "✅": true,
      "❌": true,
      "⚠": true,
      "⏳": true,
      "🔵": true,
      "🔴": true,
      "🔄": true,
      "•": true
    }
  }
}
